# Official TNGIS WMS integration. Do not commit a real session cookie.
TNGIS_WMS_URL=https://tngis.tn.gov.in/geoserver/wms
# Obtain after signing in to the public TNGIS portal; the connector only proxies permitted layers.
TNGIS_SESSION_COOKIE=
# Comma-separated WMS layer names from GetCapabilities, for example: workspace:public_roads
TNGIS_WMS_LAYERS=
