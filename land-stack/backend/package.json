{
  "name": "land-stack-backend",
  "version": "1.0.0",
  "description": "LAND STACK Backend REST API - Integrated GIS-based DPI for Land Governance",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx src/test/gis.test.ts",
    "test:phase5": "tsx src/test/phase5.test.ts",
    "test:villages": "tsx src/test/villageBoundaries.test.ts",
    "gis:seed": "tsx src/gis/scripts/gisSeeder.ts",
    "gis:migrate-parcels": "tsx src/gis/scripts/migrateMockParcels.ts",
    "gis:import-real": "tsx src/gis/scripts/realDataImporter.ts all",
    "gis:import-boundaries": "tsx src/gis/scripts/realDataImporter.ts boundaries",
    "gis:import-gsi": "tsx src/gis/scripts/realDataImporter.ts gsi",
    "gis:import-villages": "tsx src/gis/scripts/villageBoundaryImporter.ts",
    "gis:import-subdistricts": "tsx src/gis/scripts/subdistrictBoundaryImporter.ts",
    "gis:import-districts": "tsx src/gis/scripts/districtBoundaryImporter.ts",
    "gis:download-boundaries": "tsx src/gis/scripts/downloadBoundaryData.ts",
    "gis:import-chandigarh": "tsx src/gis/ingestion/adapters/adapterEngine.ts src/gis/ingestion/adapters/chandigarh.config.json src/gis/ingestion/sources/chandigarh_mock.json",
    "gis:seed-officers": "tsx src/gis/scripts/seedOfficersFromCSV.ts",
    "gis:seed-dashboards": "tsx src/gis/scripts/seedDashboardDemoData.ts",
    "gis:seed-hierarchy": "tsx src/gis/scripts/seedRealHierarchyAndCensus.ts",
    "gis:create-tables": "tsx src/gis/scripts/createAllTables.ts"
  },
  "dependencies": {
    "@types/shapefile": "^0.6.4",
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.11.5",
    "shapefile": "^0.6.6",
    "shpjs": "^6.2.0",
    "tesseract.js": "^7.0.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.4",
    "@types/shpjs": "^3.4.7",
    "@types/yargs": "^17.0.35",
    "7zip-bin": "^5.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
